# VoicePay AI — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

APP_ENV=sandbox
HOST=127.0.0.1
PORT=8000

# ── PayPal Sandbox credentials ────────────────────────────────────────────────
# Get these from: https://developer.paypal.com → My Apps & Credentials → Sandbox
# 1. Log in to developer.paypal.com
# 2. Click "Create App" under Sandbox
# 3. Copy the Client ID and Secret below
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# If set, the backend uses OpenAI to parse both payment and shopping requests.
# If blank, a deterministic rule-based fallback parser is used instead.
# The frontend will indicate which mode is active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path. Created automatically on first run.
DATABASE_URL=sqlite:///./voicepay.db

# ── Session / Access Control ──────────────────────────────────────────────────
# Required for GET /transactions access control.
# Generate a secure random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER use a short or guessable value in production.
# NEVER embed this value in frontend JavaScript source code.
DEMO_SESSION_TOKEN=replace_with_a_long_random_secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default covers common local dev servers.
# For production, set to your deployed frontend URL only.
# Do NOT include "null" — it would allow file:// and sandboxed iframes.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# ── Shopping Agent ─────────────────────────────────────────────────────────────
# No additional credentials are required for the demo product catalog.
# The catalog is bundled in the backend and is clearly labeled as demo data.
# To plug in a real product data provider, implement the catalog interface in
# backend/catalog_provider.py and set the appropriate credentials here.
#
# Example (not implemented — placeholder for real provider integration):
# PRODUCT_CATALOG_PROVIDER=rapidapi
# PRODUCT_CATALOG_API_KEY=replace_with_your_api_key
